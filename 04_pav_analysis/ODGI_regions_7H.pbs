#!/bin/bash
#PBS -N regions_7H
#PBS -l select=1:ncpus=16:mem=64GB:host=n08
#PBS -l walltime=300:00:00
#PBS -e regions_7H.err
#PBS -o regions_7H.err
#PBS -M 27445623@sun.ac.za
#PBS -m abe

module load app/apptainer
cd $PBS_O_WORKDIR

apptainer exec --cleanenv pggb.sif odgi untangle -i PGGB_out_7H/pggb_out/sorted.og -r "mxchr7H" | sed '1d' | cut -f 4,5,6 | sort | uniq | sort -k2n > PGGB_out_7H/pggb_out/regions.bed

apptainer exec --cleanenv pggb.sif odgi pav -i PGGB_out_7H/pggb_out/sorted.og -b PGGB_out_7H/pggb_out/regions.bed -S -B 0.5 -M -t 8 > PGGB_out_7H/pggb_out/pavs7H.matrix.tsv
