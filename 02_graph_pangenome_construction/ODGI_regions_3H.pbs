#!/bin/bash
#PBS -N regions_3H
#PBS -l select=1:ncpus=32:mem=64GB:host=n05
#PBS -l walltime=400:00:00
#PBS -e regions_3H.err
#PBS -o regions_3H.err
#PBS -M 27445623@sun.ac.za
#PBS -m abe

module load app/apptainer
cd $PBS_O_WORKDIR

apptainer exec --cleanenv pggb.sif odgi untangle -i PGGB_out_3H/pggb_out/sorted.og -r "mxchr3H" | sed '1d' | cut -f 4,5,6 | sort | uniq | sort -k2n > PGGB_out_3H/pggb_out/regions.bed

apptainer exec --cleanenv pggb.sif odgi pav -i PGGB_out_3H/pggb_out/sorted.og -b PGGB_out_3H/pggb_out/regions.bed -S -B 0.5 -M -t 32 > PGGB_out_3H/pggb_out/pavs3H.matrix.tsv
